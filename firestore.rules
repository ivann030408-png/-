rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCoord(v) {
      return (v is int || v is float) && v >= -200 && v <= 200;
    }

    function isValidAngle(v) {
      return (v is int || v is float) && v >= -3600 && v <= 3600;
    }

    function isValidMemberList(listVal) {
      return listVal is list &&
             listVal.size() >= 1 &&
             listVal.size() <= 8 &&
             listVal[0] is string &&
             listVal[0].size() >= 1 &&
             listVal[0].size() <= 128;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 30 &&
             data.totalKills is int && data.totalKills >= 0 && data.totalKills <= 1000000 &&
             (!('totalWins' in data) || (data.totalWins is int && data.totalWins >= 0 && data.totalWins <= 1000000)) &&
             (!('coins' in data) || (data.coins is int && data.coins >= 0 && data.coins <= 10000000)) &&
             data.totalMatches is int && data.totalMatches >= 0 && data.totalMatches <= 1000000 &&
             data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000 &&
             (!('selectedSkin' in data) || (data.selectedSkin is string && data.selectedSkin.size() <= 32 &&
               (data.selectedSkin == 'CLASSIC' || data.selectedSkin == 'SPEC_OPS' ||
                data.selectedSkin == 'GOLDEN_KING' || data.selectedSkin == 'CYBER_NEON' ||
                data.selectedSkin == 'SHADOW_NINJA' || data.selectedSkin == 'ARCTIC_FROST'))) &&
             (!('weaponSkin' in data) || (data.weaponSkin is string && data.weaponSkin.size() <= 16 &&
               (data.weaponSkin == 'CLASSIC' || data.weaponSkin == 'TACTICAL'))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyMission(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.dayKey is string && data.dayKey.size() == 10 && data.dayKey.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') &&
             data.slotIndex is int && data.slotIndex >= 0 && data.slotIndex <= 2 &&
             data.missionType is string && data.missionType.size() <= 24 &&
             (data.missionType == 'KILLS' || data.missionType == 'DRIVE_METERS' ||
              data.missionType == 'BUILD_PROPS' || data.missionType == 'DESTROY_PROPS' ||
              data.missionType == 'ROADKILL' || data.missionType == 'PLAY_MATCHES' ||
              data.missionType == 'WIN_MATCH' || data.missionType == 'EXPLOSIONS') &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.target is int && data.target >= 1 && data.target <= 10000 &&
             data.progress is int && data.progress >= 0 && data.progress <= data.target &&
             data.rewardCoins is int && data.rewardCoins >= 10 && data.rewardCoins <= 1000 &&
             data.status is string && data.status.size() <= 16 &&
             (data.status == 'active' || data.status == 'completed' || data.status == 'claimed') &&
             (data.status == 'active' || data.progress >= data.target) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 30 &&
             data.kills is int && data.kills >= 0 && data.kills <= 1000000 &&
             data.wins is int && data.wins >= 0 && data.wins <= 1000000 &&
             data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 1000000 &&
             data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000 &&
             data.visibility is string && data.visibility.size() <= 16 && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGameRoom(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.roomCode.matches('^[A-Z0-9]+$') &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 40 &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.status is string && data.status.size() <= 16 && (data.status == 'open' || data.status == 'closed') &&
             data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 8 &&
             (!('mapId' in data) || (data.mapId is string && data.mapId.size() <= 32 &&
               (data.mapId == 'MAIN_ARENA' || data.mapId == 'TURBO_SPEEDWAY' || data.mapId == 'TACTICAL_COMPOUND'))) &&
             (!('gameMode' in data) || (data.gameMode is string && data.gameMode.size() <= 16 &&
               (data.gameMode == 'SANDBOX' || data.gameMode == 'PVP' || data.gameMode == 'RACING'))) &&
             (!('privateRoom' in data) || data.privateRoom is bool) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 24)) &&
             (!('pinned' in data) || data.pinned is bool) &&
             (!('joinLocked' in data) || data.joinLocked is bool) &&
             (!('allowGuestPropSpawn' in data) || data.allowGuestPropSpawn is bool) &&
             (!('allowGuestVehicleSpawn' in data) || data.allowGuestVehicleSpawn is bool) &&
             (!('friendlyFire' in data) || data.friendlyFire is bool) &&
             (!('infiniteAmmo' in data) || data.infiniteAmmo is bool) &&
             (!('godMode' in data) || data.godMode is bool) &&
             isValidMemberList(data.memberUids) &&
             data.memberUids.size() <= data.maxPlayers &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomPlayer(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             isValidCoord(data.x) &&
             isValidCoord(data.y) &&
             isValidCoord(data.z) &&
             isValidAngle(data.yaw) &&
             isValidAngle(data.pitch) &&
             data.hp is int && data.hp >= 0 && data.hp <= 100 &&
             data.kills is int && data.kills >= 0 && data.kills <= 9999 &&
             data.weapon is string && data.weapon.size() <= 16 &&
             (data.weapon == 'PISTOL' || data.weapon == 'RIFLE' || data.weapon == 'RPG') &&
             data.drivingVehicle is bool &&
             data.shooting is bool &&
             (!('godMode' in data) || data.godMode is bool) &&
             (!('canBuild' in data) || data.canBuild is bool) &&
             isValidMemberList(data.memberUids) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomProp(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.propType is string && data.propType.size() <= 16 &&
             (data.propType == 'CRATE' || data.propType == 'WALL' || data.propType == 'RAMP' || data.propType == 'BARREL' || data.propType == 'CAR') &&
             isValidCoord(data.x) &&
             isValidCoord(data.y) &&
             isValidCoord(data.z) &&
             isValidAngle(data.yaw) &&
             data.hp is int && data.hp >= 0 && data.hp <= 500 &&
             data.destroyed is bool &&
             isValidMemberList(data.memberUids) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomMessage(data) {
      return data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 30 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 200 &&
             isValidMemberList(data.memberUids) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- 1. USER PROFILES ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'nickname', 'totalKills', 'totalMatches', 'bestStreak', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'nickname', 'totalKills', 'totalWins', 'coins', 'totalMatches', 'bestStreak', 'selectedSkin', 'weaponSkin', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'totalKills', 'totalWins', 'coins', 'totalMatches', 'bestStreak', 'selectedSkin', 'weaponSkin', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // --- 1A. DAILY MISSIONS SUBCOLLECTION ---
      match /daily_missions/{missionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(missionId) &&
                      request.auth.uid == userId;

        allow list: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(missionId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'active' &&
                         incoming().progress == 0 &&
                         incoming().keys().hasAll(['userId', 'dayKey', 'slotIndex', 'missionType', 'title', 'target', 'progress', 'rewardCoins', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dayKey', 'slotIndex', 'missionType', 'title', 'target', 'progress', 'rewardCoins', 'status', 'createdAt', 'updatedAt']) &&
                         isValidDailyMission(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(missionId) &&
                         request.auth.uid == userId &&
                         existing().status != 'claimed' &&
                         isValidDailyMission(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().dayKey == existing().dayKey &&
                         incoming().slotIndex == existing().slotIndex &&
                         incoming().missionType == existing().missionType &&
                         incoming().title == existing().title &&
                         incoming().target == existing().target &&
                         incoming().rewardCoins == existing().rewardCoins &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().progress >= existing().progress &&
                         (existing().status != 'completed' || incoming().status != 'active') &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'status', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(missionId) &&
                         request.auth.uid == userId;
      }
    }

    // --- 2. ONLINE MULTIPLAYER ROOMS ---
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) &&
                    (existing().status == 'open' || request.auth.uid in existing().memberUids);

      allow list: if isSignedIn() &&
                     (existing().status == 'open' || request.auth.uid in existing().memberUids);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().keys().hasAll(['roomCode', 'name', 'hostId', 'status', 'maxPlayers', 'memberUids', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'name', 'hostId', 'status', 'maxPlayers', 'memberUids',
                         'mapId', 'gameMode', 'privateRoom', 'password', 'pinned', 'joinLocked',
                         'allowGuestPropSpawn', 'allowGuestVehicleSpawn', 'friendlyFire', 'infiniteAmmo', 'godMode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidGameRoom(incoming()) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().memberUids == [request.auth.uid];

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidGameRoom(incoming()) &&
                       existing().status != 'closed' &&
                       incoming().hostId == existing().hostId &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Host updates room settings, pins/locks/closes room, or kicks non-host members
                         (existing().hostId == request.auth.uid &&
                          (existing().hostId in incoming().memberUids) &&
                          existing().memberUids.hasAll(incoming().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'name', 'status', 'maxPlayers', 'mapId', 'gameMode', 'privateRoom', 'password',
                            'pinned', 'joinLocked', 'allowGuestPropSpawn', 'allowGuestVehicleSpawn',
                            'friendlyFire', 'infiniteAmmo', 'godMode', 'memberUids', 'updatedAt'
                          ])) ||
                         // Action 2: Authenticated player joins open unlocked room
                         (existing().status == 'open' &&
                          (!('joinLocked' in existing()) || existing().joinLocked == false) &&
                          incoming().maxPlayers == existing().maxPlayers &&
                          !(request.auth.uid in existing().memberUids) &&
                          incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                          incoming().memberUids.size() <= existing().maxPlayers &&
                          incoming().memberUids.hasAll(existing().memberUids) &&
                          (request.auth.uid in incoming().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                         // Action 3: Non-host member leaves room
                         ((request.auth.uid in existing().memberUids) &&
                          existing().hostId != request.auth.uid &&
                          incoming().maxPlayers == existing().maxPlayers &&
                          incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                          existing().memberUids.hasAll(incoming().memberUids) &&
                          !(request.auth.uid in incoming().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      // --- 2A. LIVE 3D PLAYERS IN ROOM ---
      match /players/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
                      (request.auth.uid == playerId || request.auth.uid in existing().memberUids);

        allow list: if isSignedIn() && (request.auth.uid in existing().memberUids);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         playerId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'displayName', 'x', 'y', 'z', 'yaw', 'pitch', 'hp', 'kills', 'weapon', 'drivingVehicle', 'shooting', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'displayName', 'x', 'y', 'z', 'yaw', 'pitch', 'hp', 'kills', 'weapon', 'drivingVehicle', 'shooting', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isValidRoomPlayer(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         (request.auth.uid in incoming().memberUids) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids);

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isValidRoomPlayer(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids) &&
                         (
                           // Action 1: Player updates own 3D state & syncs memberUids (cannot self-modify host privileges)
                           (playerId == request.auth.uid &&
                            (request.auth.uid in incoming().memberUids) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'x', 'y', 'z', 'yaw', 'pitch', 'hp', 'kills', 'weapon', 'drivingVehicle', 'shooting', 'memberUids', 'updatedAt'])) ||
                           // Action 2: Opponent deals combat damage in the same room (blocked if target has host-granted godMode)
                           (playerId != request.auth.uid &&
                            (!('godMode' in existing()) || existing().godMode == false) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['hp', 'updatedAt'])) ||
                           // Action 3: Room host grants or revokes per-player privileges (godMode / canBuild)
                           (get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['godMode', 'canBuild', 'updatedAt']))
                         );

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         (playerId == request.auth.uid ||
                          (exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                           get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid));
      }

      // --- 2B. SANDBOX 3D PROPS IN ROOM ---
      match /props/{propId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(propId) &&
                      (request.auth.uid in existing().memberUids);

        allow list: if isSignedIn() && (request.auth.uid in existing().memberUids);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(propId) &&
                         incoming().keys().hasAll(['ownerId', 'propType', 'x', 'y', 'z', 'yaw', 'hp', 'destroyed', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['ownerId', 'propType', 'x', 'y', 'z', 'yaw', 'hp', 'destroyed', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isValidRoomProp(incoming()) &&
                         incoming().ownerId == request.auth.uid &&
                         (request.auth.uid in incoming().memberUids) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids);

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(propId) &&
                         isValidRoomProp(incoming()) &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().propType == existing().propType &&
                         incoming().createdAt == existing().createdAt &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids) &&
                         (
                           // Action 1: Any room member damages, detonates, or moves a prop
                           incoming().diff(existing()).affectedKeys().hasOnly(['hp', 'destroyed', 'x', 'y', 'z', 'yaw', 'updatedAt']) ||
                           // Action 2: Sync denormalized room memberUids
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         );

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(propId) &&
                         (existing().ownerId == request.auth.uid ||
                          (exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                           get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid));
      }

      // --- 2C. REAL-TIME MULTIPLAYER CHAT MESSAGES IN ROOM ---
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
                      (request.auth.uid in existing().memberUids);

        allow list: if isSignedIn() && (request.auth.uid in existing().memberUids);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['senderId', 'senderName', 'text', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['senderId', 'senderName', 'text', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isValidRoomMessage(incoming()) &&
                         incoming().senderId == request.auth.uid &&
                         (request.auth.uid in incoming().memberUids) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids);

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidRoomMessage(incoming()) &&
                         incoming().senderId == existing().senderId &&
                         incoming().senderName == existing().senderName &&
                         incoming().text == existing().text &&
                         incoming().createdAt == existing().createdAt &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids) &&
                         (
                           // Action: Sync denormalized room memberUids when new players join
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         );

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid ||
                          (exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                           get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid));
      }
    }

    // --- 3. GLOBAL LEADERBOARD (PUBLIC GAME STATS, NO PII) ---
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId) &&
                    (request.auth.uid == userId || (resource != null && existing().visibility == 'public'));

      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'nickname', 'kills', 'wins', 'matchesPlayed', 'bestStreak', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'nickname', 'kills', 'wins', 'matchesPlayed', 'bestStreak', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'kills', 'wins', 'matchesPlayed', 'bestStreak', 'visibility', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
